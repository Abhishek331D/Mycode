class Mobile
{
	int mcost;
	String mname;
	String mcolour;
	Mobile(int a, String b,String c){
		mcost=a;
		mname=b;
		mcolour=c;
		return;
		
	}
	public static void main(String[]args){
		System.out.println("____Main Starts_____");
		Mobile m1=new Mobile(30000,"Redmi","black");
		System.out.println(m1.mcost);
		System.out.println(m1.mname);
		System.out.println(m1.mcolour);
		Mobile m2=new Mobile(50000,"1 plus","Light Green");
		System.out.println(m2.mcost);
		System.out.println(m2.mname);
		System.out.println(m2.mcolour);
		System.out.println("____Main Ends_____");
	}
}